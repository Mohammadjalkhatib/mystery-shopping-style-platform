{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commits": false,
    "pullRequests": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git checkout main:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)"
    ]
  }
}
