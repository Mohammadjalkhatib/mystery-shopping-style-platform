{
  "name": "mystery-shopping-style-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Location-verified field visits: a thin end-to-end slice.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @msp/api",
    "dev:web": "npm run dev --workspace @msp/web",
    "build": "npm run build --workspace @msp/shared && npm run build --workspace @msp/api && npm run build --workspace @msp/web",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc --build --verbose && npm run typecheck:tests",
    "db:seed": "npm run db:seed --workspace @msp/api",
    "typecheck:tests": "tsc -p apps/api/tsconfig.spec.json && tsc -p apps/web/tsconfig.spec.json"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.5.0",
    "concurrently": "10.0.5",
    "jest": "30.5.1",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
