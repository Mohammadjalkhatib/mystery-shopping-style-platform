# Copy to .env before running. Nothing in here is a real secret.

# ---------- API ----------
NODE_ENV=development
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
JWT_SECRET=change-me-locally

# ---------- Mongo ----------
# Local (docker compose). In production use the Atlas M0 SRV string.
MONGO_URI=mongodb://mongo:27017/mystery-shopping
MONGO_DB_NAME=mystery-shopping

# ---------- Object storage ----------
# S3-compatible. MinIO locally, Cloudflare R2 in production.
# Only these five values change between the two, the code does not.
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=visit-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- Verification ----------
# Thresholds are deliberately config, not constants in code. They are placeholders
# until there is labelled data to tune them against. See D-001.
VERIFY_AUTO_THRESHOLD=75
VERIFY_REJECT_THRESHOLD=30
VERIFY_ENGINE_VERSION=v1

# ---------- Retention ----------
# TTL on raw location pings, in days. This is a privacy control. See D-002.
PING_RETENTION_DAYS=30

# ---------- Sessions ----------
SESSION_HARD_CAP_SECONDS=10800
SESSION_ABANDON_AFTER_SECONDS=900

# ---------- Web ----------
VITE_API_BASE_URL=http://localhost:3000
